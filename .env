# ==============================================================================
# HACKNEXUS PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

# 1. DATABASE CONNECTION
# For Local Dev: uses local SQLite database "file:./dev.db"
# For Production (Neon.tech / Supabase / Railway): paste your PostgreSQL URI below.
# When a postgresql:// URL is detected, the build script automatically configures Prisma!
DATABASE_URL="file:./dev.db"
# DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres?sslmode=require"
# DATABASE_URL="postgresql://[USER]:[PASSWORD]@[ENDPOINT].us-east-2.aws.neon.tech/neondb?sslmode=require"

# 2. CRYPTOGRAPHIC 64-CHARACTER JWT SECRET KEY
# Used to sign and verify participant and admin session tokens securely
JWT_SECRET="31ab65e1306744cd5a3f0a0f0baf6f0e756e1d3d4a262277e97cccb1eefed639"
AUTH_SECRET="31ab65e1306744cd5a3f0a0f0baf6f0e756e1d3d4a262277e97cccb1eefed639"

# 3. PUBLIC CANONICAL APP URL
# Local: http://localhost:3000
# Production: Set to your live production domain (e.g. https://your-domain.vercel.app)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# 4. RAZORPAY PAYMENT GATEWAY CREDENTIALS (INR Gateway)
# If left as demo mode, HackNexus provides dynamic Direct UPI QR, Bank Transfer, and Demo modes!
# For real payments: enter your test/live keys from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID="rzp_test_demo_mode"
RAZORPAY_KEY_SECRET="rzp_test_secret_demo_mode"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_demo_mode"

# 5. DEFAULT HACKATHON SLUG
NEXT_PUBLIC_DEFAULT_HACKATHON_SLUG="national-innovation-hackathon-2026"
