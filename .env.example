# ==============================================================================
# HACKNEXUS ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# 1. DATABASE CONNECTION
# Local SQLite default: "file:./dev.db"
# Production PostgreSQL (Neon.tech or Supabase):
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres?sslmode=require"

# 2. CRYPTOGRAPHIC 64-CHARACTER JWT SECRET KEY
# Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="31ab65e1306744cd5a3f0a0f0baf6f0e756e1d3d4a262277e97cccb1eefed639"
AUTH_SECRET="31ab65e1306744cd5a3f0a0f0baf6f0e756e1d3d4a262277e97cccb1eefed639"

# 3. PUBLIC CANONICAL APP URL
NEXT_PUBLIC_APP_URL="https://your-domain.vercel.app"

# 4. RAZORPAY PAYMENT GATEWAY CREDENTIALS (INR Gateway)
# From Razorpay Dashboard -> Settings -> API Keys:
RAZORPAY_KEY_ID="rzp_live_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_secret"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_live_your_key_id"

# 5. DEFAULT HACKATHON SLUG
NEXT_PUBLIC_DEFAULT_HACKATHON_SLUG="national-innovation-hackathon-2026"
