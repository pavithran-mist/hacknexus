# HackNexus Environment Variables
# Copy to .env for local development

# Database connection
# For local SQLite out-of-the-box development:
DATABASE_URL="file:./dev.db"
# For PostgreSQL production deployment (e.g., Supabase / Neon / AWS RDS):
# DATABASE_URL="postgresql://username:password@localhost:5432/hacknexus?schema=public"

# Authentication & Session Security (Generate with: openssl rand -base64 32)
AUTH_SECRET="hacknexus_super_secret_production_ready_jwt_key_2026_xyz"

# Public URL of the application
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Razorpay Payment Gateway (INR)
# In development mode, leave empty or demo keys to use DEMO PAYMENT mode
RAZORPAY_KEY_ID="rzp_test_mock_hacknexus_key"
RAZORPAY_KEY_SECRET="mock_secret_do_not_expose_in_client"

# Object Storage for Project Attachments (S3 / Cloudflare R2 / MinIO)
STORAGE_BUCKET="hacknexus-assets"
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
STORAGE_REGION="auto"
STORAGE_ENDPOINT=""

# Email Notifications (SMTP Server)
EMAIL_SERVER="smtp://user:pass@smtp.example.com:587"
EMAIL_FROM="noreply@hacknexus.io"

# System Defaults
NEXT_PUBLIC_DEFAULT_HACKATHON_SLUG="national-innovation-hackathon-2026"
